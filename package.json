{
  "name": "nomarmy",
  "description": "Every byte verified: a harness for AI coding workers whose claims are never trusted. Your coding assistant stays in charge while workers implement and test in sandboxes, and nomArmy checks every change before it is committed.",
  "author": "Rayson Technologies",
  "license": "Apache-2.0",
  "version": "0.1.0-alpha.8",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayson-tech/nomarmy.git"
  },
  "homepage": "https://github.com/rayson-tech/nomarmy#readme",
  "bugs": {
    "url": "https://github.com/rayson-tech/nomarmy/issues"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@secretlint/node": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "docs:harnesses": "node scripts/generate-harness-docs.mjs"
  },
  "bin": {
    "nomarmy": "bin/nomarmy.mjs"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "config",
    "playbooks",
    "notifier",
    "scripts",
    "policies",
    "docker",
    "harnesses",
    "install.sh",
    "e2e.sh",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!config/profiles/*.local.env"
  ],
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "llm",
    "llama.cpp",
    "local-llm",
    "sandbox",
    "verification",
    "agents"
  ]
}
