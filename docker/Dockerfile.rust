FROM node:24-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
# Same base as docker/Dockerfile plus a Rust toolchain -- the worker's own
# tool-calling harness needs Node regardless of the target repo's language.
# Debian bookworm's packaged rustc/cargo lags stable Rust noticeably, and
# real Cargo.toml files routinely need a recent edition/toolchain, so this
# uses rustup (network access is fine here -- this is the BUILD step,
# offline, on the host; the running container it produces still gets
# --network none like every other job sandbox).
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq python3 python3-pip python3-venv ripgrep build-essential \
    && rm -rf /var/lib/apt/lists/*
USER node
ENV RUSTUP_HOME=/home/node/.rustup
ENV CARGO_HOME=/home/node/.cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"
# rustup-init is pinned by version and checksum instead of piping
# sh.rustup.rs into sh; rustup then verifies the toolchain it downloads.
# Bump RUSTUP_VERSION and both hashes together, from
# https://static.rust-lang.org/rustup/archive/<version>/<target>/rustup-init.sha256.
ENV RUSTUP_VERSION=1.29.1
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
         amd64) TARGET=x86_64-unknown-linux-gnu; SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71 ;; \
         arm64) TARGET=aarch64-unknown-linux-gnu; SHA256=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433 ;; \
         *) echo "unsupported architecture for Rust install: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${TARGET}/rustup-init" -o /tmp/rustup-init \
    && echo "${SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain stable \
    && rm /tmp/rustup-init
WORKDIR /workspace
CMD ["sleep", "infinity"]
