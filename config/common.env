NOMARMY_MODEL_REPO=ggml-org/gpt-oss-20b-GGUF
NOMARMY_MODEL_QUANT=MXFP4
NOMARMY_MODEL_ALIAS=gpt-oss-20b
# Whether the configured model has a thinking/reasoning mode at all --
# Coder-Next does not. `nomarmy connect` reads this (and NOMARMY_WORKER_MODEL
# below) to keep the MCP registration's worker-routing env vars in sync with
# whatever model is actually configured here, instead of the two silently
# drifting apart (the exact bug this fixes: NOMARMY_WORKER_MODEL sat unused
# in this file for every model choice until now).
NOMARMY_MODEL_THINKING=true
NOMARMY_LLAMA_HOST=127.0.0.1
NOMARMY_LLAMA_PORT=8080
NOMARMY_LLAMA_CONTEXT=65536
NOMARMY_LLAMA_PARALLEL=1
NOMARMY_MAX_WORKERS=1
NOMARMY_AGENT_IMAGE=openclaw-nomarmy-coder:bookworm
NOMARMY_INSTALL_ROOT=$HOME/.local/share/nomarmy-local-agents

# Where models run: 'local' runs llama-server on this machine, 'remote' uses
# one nomArmy doesn't run (nomarmy setup --llama-url), 'hosted' has no local
# model at all (nomarmy setup --hosted), 'bedrock' calls Bedrock. Profiles
# override this.
NOMARMY_EXECUTION=local

# Worker model routing. The MCP server composes "<provider>/<model>" for
# OpenClaw, so these are the only place model identity is declared.
NOMARMY_WORKER_PROVIDER=llama-cpp
NOMARMY_WORKER_MODEL=gpt-oss-20b
NOMARMY_WORKER_MODEL_FALLBACK=gpt-oss-20b

# 'frontier' means the coordinator outranks the workers it reviews, which is
# what policies/reviewer.md assumes. 'degraded' is the explicit opt-out.
NOMARMY_ORCHESTRATOR_TRUST=frontier
