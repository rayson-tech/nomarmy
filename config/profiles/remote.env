# A llama-server nomArmy doesn't run, e.g. a team's GPU server or an SSH
# tunnel to one. Set its address with `nomarmy setup --llama-url
# http://host:8080`, which writes NOMARMY_LLAMA_HOST / NOMARMY_LLAMA_PORT
# into config/common.env. nomArmy
# doesn't start, stop or size that server; the sandbox, git worktrees and
# verification still run on this machine.
NOMARMY_PROFILE=remote
NOMARMY_EXECUTION=remote
NOMARMY_MAX_WORKERS=1
