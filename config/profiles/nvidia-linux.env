# Generic NVIDIA Linux/CUDA worker. Tune for available VRAM/system memory.
NOMARMY_PROFILE=nvidia-linux
NOMARMY_LLAMA_GPU_LAYERS=999
NOMARMY_LLAMA_THREADS=12
# Conservative for unknown VRAM. Raise to 65536 for the v1.3 autonomous loop
# where the card allows: NOMARMY_LLAMA_CONTEXT=65536 ./install.sh --profile nvidia-linux
NOMARMY_LLAMA_CONTEXT=32768
NOMARMY_LLAMA_PARALLEL=1
NOMARMY_MAX_WORKERS=1
