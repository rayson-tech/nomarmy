# Apple Silicon / Metal. Conservative defaults for 64 GB unified memory.
NOMARMY_PROFILE=macbook-pro
NOMARMY_LLAMA_GPU_LAYERS=999
NOMARMY_LLAMA_THREADS=12
# v1.3 raises this from 32K: the autonomous explore/implement/test/repair loop
# needs more room than a one-shot edit. 64 GB unified memory carries 64K.
NOMARMY_LLAMA_CONTEXT=65536
NOMARMY_LLAMA_PARALLEL=1
NOMARMY_MAX_WORKERS=1
