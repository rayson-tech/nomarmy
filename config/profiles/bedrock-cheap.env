# DEGRADED-ACCEPTANCE PROFILE: read policies/reviewer.md before using.
#
# Orchestrator and workers are the same capability class, so the coordinator is
# grading output from a peer rather than from below. Acceptance stops being an
# independent check. Use only where a wrong accept is cheap and reversible, and
# never for security decisions, architecture, or anything heading for a release.
#
# Note this path cannot be Claude Code: CLAUDE_CODE_USE_BEDROCK only routes
# Anthropic models. The coordinator here is OpenClaw driving the same MCP server.
NOMARMY_PROFILE=bedrock-cheap
NOMARMY_EXECUTION=bedrock

NOMARMY_BEDROCK_REGION=eu-west-2

# --- Orchestrator -----------------------------------------------------------
NOMARMY_ORCHESTRATOR_RUNTIME=openclaw
NOMARMY_ORCHESTRATOR_MODEL=qwen.qwen3-coder-next
NOMARMY_ORCHESTRATOR_TRUST=degraded

# --- Workers ----------------------------------------------------------------
NOMARMY_WORKER_PROVIDER=bedrock
NOMARMY_WORKER_AUTH_CHOICE=openai-compatible-existing-server
NOMARMY_WORKER_MODEL=qwen.qwen3-coder-next
NOMARMY_WORKER_MODEL_FALLBACK=nvidia.nemotron-nano-3-30b

NOMARMY_MAX_WORKERS=4
