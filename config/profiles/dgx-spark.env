# NVIDIA DGX Spark / GB10 Grace Blackwell, Linux ARM64, CUDA.
# Start conservative; raise parallelism only after E2E passes and memory is measured.
#
# NOTE: -c is divided across -np, so 65536 with 2 slots gives each nom 32K,
# below the v1.3 64K-per-nom target. Run `nomarmy sizing` on the machine and
# apply what it recommends rather than trusting these defaults.
NOMARMY_PROFILE=dgx-spark
NOMARMY_LLAMA_GPU_LAYERS=999
NOMARMY_LLAMA_THREADS=16
NOMARMY_LLAMA_CONTEXT=65536
NOMARMY_LLAMA_PARALLEL=2
NOMARMY_MAX_WORKERS=2
