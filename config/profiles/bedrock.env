# Bedrock-hosted orchestrator and workers. No local inference, so this profile
# carries no GPU or OS requirement and runs anywhere AWS credentials resolve.
NOMARMY_PROFILE=bedrock
NOMARMY_EXECUTION=bedrock

# Region, models and worker count honour an environment override; the value here
# is the default. Base URL is derived from the region unless you set it.
NOMARMY_BEDROCK_REGION=eu-west-2
# NOMARMY_BEDROCK_BASE_URL=https://bedrock-runtime.eu-west-2.amazonaws.com/openai/v1

# --- Orchestrator -----------------------------------------------------------
# Claude Opus 5 served from Bedrock. The coordinator still outranks the workers
# it reviews, so policies/orchestrator.md and policies/reviewer.md hold as written.
NOMARMY_ORCHESTRATOR_RUNTIME=claude-code
NOMARMY_ORCHESTRATOR_MODEL=eu.anthropic.claude-opus-5
NOMARMY_ORCHESTRATOR_TRUST=frontier

# --- Workers ----------------------------------------------------------------
# Bedrock model IDs. Confirm against `aws bedrock list-foundation-models`;
# scripts/verify-install.sh checks these are invokable in your account.
NOMARMY_WORKER_PROVIDER=bedrock
NOMARMY_WORKER_AUTH_CHOICE=openai-compatible-existing-server
NOMARMY_WORKER_MODEL=qwen.qwen3-coder-next
NOMARMY_WORKER_MODEL_FALLBACK=nvidia.nemotron-3-super-120b

# Hosted inference removes the VRAM ceiling; the practical limit is now your
# Bedrock TPM quota and your budget. Still measure before raising further.
NOMARMY_MAX_WORKERS=4
